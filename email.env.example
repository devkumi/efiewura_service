# =============================================================================
# EMAIL NOTIFICATION CONFIGURATION FOR EFIEWURA
# =============================================================================

# Basic Email Configuration
EMAIL_NOTIFICATIONS_ENABLED=true
MAIL_MAILER=log  # Change to 'smtp' for production
MAIL_FROM_ADDRESS=notifications@efiewura.com
MAIL_FROM_NAME="Efiewura Notifications"

# =============================================================================
# SMTP Configuration (for production)
# =============================================================================

# Gmail SMTP (for testing/development)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-gmail@gmail.com
# MAIL_PASSWORD=your-app-password  # Use App Password, not your Gmail password
# MAIL_ENCRYPTION=tls

# SendGrid SMTP (recommended for production)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=your-sendgrid-api-key
# MAIL_ENCRYPTION=tls

# Mailgun SMTP
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.mailgun.org
# MAIL_PORT=587
# MAIL_USERNAME=your-mailgun-username
# MAIL_PASSWORD=your-mailgun-password
# MAIL_ENCRYPTION=tls

# Amazon SES SMTP
# MAIL_MAILER=smtp
# MAIL_HOST=email-smtp.us-east-1.amazonaws.com
# MAIL_PORT=587
# MAIL_USERNAME=your-ses-username
# MAIL_PASSWORD=your-ses-password
# MAIL_ENCRYPTION=tls

# =============================================================================
# Email Service API Configuration (alternative to SMTP)
# =============================================================================

# Mailgun API
# MAILGUN_DOMAIN=your-domain.mailgun.org
# MAILGUN_SECRET=your-mailgun-secret-key

# SendGrid API
# SENDGRID_API_KEY=your-sendgrid-api-key

# Amazon SES API
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_DEFAULT_REGION=us-east-1

# =============================================================================
# Email Processing Configuration
# =============================================================================

# Batch processing
EMAIL_BATCH_SIZE=100
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_DELAY=300

# Rate limiting
EMAIL_RATE_LIMIT_PER_MINUTE=60
EMAIL_RATE_LIMIT_PER_HOUR=1000
EMAIL_RATE_LIMIT_PER_DAY=10000

# Queue configuration (for high-volume sending)
EMAIL_USE_QUEUE=false
EMAIL_QUEUE_NAME=emails
EMAIL_DELAY_SECONDS=0

# =============================================================================
# Email Content Configuration
# =============================================================================

# Company information
SUPPORT_EMAIL=support@efiewura.com
FACEBOOK_URL=https://facebook.com/efiewura
TWITTER_URL=https://twitter.com/efiewura
LINKEDIN_URL=https://linkedin.com/company/efiewura
INSTAGRAM_URL=https://instagram.com/efiewura

# =============================================================================
# Development and Testing
# =============================================================================

# Test email addresses
TEST_EMAIL_1=test1@efiewura.com
TEST_EMAIL_2=test2@efiewura.com

# Email logging
EMAIL_LOGGING_ENABLED=true
EMAIL_LOG_LEVEL=info
EMAIL_LOG_CHANNEL=single

# Email tracking (for production with supported services)
EMAIL_OPEN_TRACKING=false
EMAIL_CLICK_TRACKING=false
EMAIL_BOUNCE_TRACKING=false

# Unsubscribe functionality
EMAIL_UNSUBSCRIBE_ENABLED=true

# =============================================================================
# QUICK SETUP GUIDE
# =============================================================================

# For Development:
# 1. Keep MAIL_MAILER=log to see emails in storage/logs/laravel.log
# 2. Set EMAIL_NOTIFICATIONS_ENABLED=true
# 3. Test with: php artisan notifications:send-emails --test

# For Production with Gmail (simple setup):
# 1. Set MAIL_MAILER=smtp
# 2. Set MAIL_HOST=smtp.gmail.com
# 3. Set MAIL_PORT=587
# 4. Set MAIL_USERNAME=your-gmail@gmail.com
# 5. Set MAIL_PASSWORD=your-gmail-app-password
# 6. Set MAIL_ENCRYPTION=tls
# 7. Enable 2FA and generate App Password in Gmail settings

# For Production with SendGrid (recommended):
# 1. Sign up for SendGrid account
# 2. Create API key with mail send permissions
# 3. Set MAIL_MAILER=smtp
# 4. Set MAIL_HOST=smtp.sendgrid.net
# 5. Set MAIL_PORT=587
# 6. Set MAIL_USERNAME=apikey
# 7. Set MAIL_PASSWORD=your-sendgrid-api-key
# 8. Set MAIL_ENCRYPTION=tls

# Test Configuration:
# Run: php artisan notifications:send-emails --test
# This will test your email configuration without sending actual emails

# =============================================================================
